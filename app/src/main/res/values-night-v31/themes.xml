<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night resources outrank values-v31, so without this file dark-mode Android 12+ devices
         lost the branded splash icon and colours. Keep in sync with values-v31. -->
    <style name="Theme.AutoRR" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
